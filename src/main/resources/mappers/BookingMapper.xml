<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="com.digging.spring.ajax.repository.BookingRepository">
 
  <select id="searchBooking" parameterType="map"
   resultType="com.digging.spring.ajax.domain.Booking">
 	SELECT
 		`name`
 		, `date`
		, `day`
		, `headcount`
		, `state`
	FROM
		`booking`
	WHERE
		`name` = #{name} AND `phoneNumber` = #{phoneNumber}
	ORDER BY
 		`name` DESC
 	LIMIT
 		1
 </select>
 
 <select id="selectBookingList" parameterType="com.digging.spring.ajax.domain.Booking">
 	SELECT
 		`id`
		, `name`
		, `headcount`
		, `day` 
		, `date` 
		, `phoneNumber`
		, `state`
		, `createdAt`
		, `updatedAt`
	FROM
		`booking`
 </select>
 
 <delete id="deleteBooking" parameterType="int">
 	DELETE FROM 
 		`booking`
 	WHERE
 		`id` = #{id};
 </delete>
 
 <insert id="insertBooking" parameterType="map">
 	INSERT INTO
 		`booking`
 	(
 		`name`
 		, `date`
 		, `day`
 		, `headcount`
 		, `phoneNumber`
 		, `state`
 	)
 	VALUES
 	(
 		#{name}
 		, #{date}
 		, #{day}
 		, #{headcount}
 		, #{phoneNumber}
 		, #{state}
 	)
 </insert>
 
 </mapper>