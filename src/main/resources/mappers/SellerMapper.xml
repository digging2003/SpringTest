<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="SellerRepository">
 	<insert id="">
 	    INSERT INTO `real_estate`
    (
 		`realtorId` 
		, `address` 
		, `area`
		, `type`
		, `price`
		, `rentPrice`
		, `createdAt`
		, `updatedAt`
    )
    VALUES
    (
		#{realtorId}
        , #{address}
        , #{area}
        , #{type}
        , #{price}
        , #{rentPrice}
        , NOW()
        , NOW()
    )
 	</insert>
 </mapper>